
config CUSTOM_KERNEL_STEP_COUNTER
	bool "CUSTOM_KERNEL_STEP_COUNTER"
	help
	  A step counter is a device, usually portable and electronic or electromechanical,
	  that counts each step a person takes by detecting the motion of the person's hands or hips.

config CUSTOM_KERNEL_SIGNIFICANT_MOTION_SENSOR
	bool "BMI160 significant motion sensor"
	depends on CUSTOM_KERNEL_STEP_COUNTER
	help
	  Enable the Android significant-motion wake-up sensor backed by the
	  physical BMI160 accelerometer interrupt.

source "drivers/misc/mediatek/sensors-1.0/step_counter/bmi160_stc/Kconfig"
